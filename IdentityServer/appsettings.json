{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "identityserver:"
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "TokenPermitLimit": 300,
    "WindowSeconds": 60
  }
}
